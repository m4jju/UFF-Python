import sys

N = int(input())
esforco = sys.maxsize

# Para cada trilha
for i in range(1, N+1):
    H = -1
    ida = 0
    volta = 0
    entradas = input()
    dados = entradas. split()
    M = int(dados[0])

    #A cada medição
    for j in range(1, M + 1):
        Hi = int (dados[j])
        if H >= 0:
            if (Hi - H) > 0: 
                ida = ida + (Hi - H)
            elif (Hi - H) < 0:
                volta = volta - (Hi - H)
        H = Hi
    
    esforco_atual = min(ida, volta)

    if esforco_atual < esforco:
        esforco = esforco_atual
        menor = i

print(menor)